---
import { isChinese, localizedPath, text } from '../lib/i18n';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>;
  artistName: string;
}
const { work, artistName } = Astro.props;
const chinese = isChinese(Astro.url);
---

<a class="card" href={localizedPath(`/works/${work.id}/`, chinese)} style={`--ar: ${(work.data.image.width / work.data.image.height).toFixed(3)}`}>
  <Image
    src={work.data.image}
    widths={[400, 800]}
    sizes="(min-width: 700px) 400px, 100vw"
    alt={text(chinese, `${work.data.title} by ${artistName}`, `${artistName}《${work.data.title}》`)}
  />
  <h3>{work.data.title}</h3>
  <p>{artistName}, {work.data.year}</p>
</a>
