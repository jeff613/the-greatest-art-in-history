---
import { isChinese, text } from '../lib/i18n';
import type { MusicTrack } from '../lib/artwork-music';
interface Props {
  track: MusicTrack;
  alternatives?: MusicTrack[];
}
const { track, alternatives = [] } = Astro.props;
const tracks = [track, ...alternatives];
const chinese = isChinese(Astro.url);
const t = (english: string, zh: string) => text(chinese, english, zh);

const DEEDS: Record<string, string> = {
  'CC BY 3.0': 'https://creativecommons.org/licenses/by/3.0/',
  'CC BY 4.0': 'https://creativecommons.org/licenses/by/4.0/',
  'CC BY-SA 2.5': 'https://creativecommons.org/licenses/by-sa/2.5/',
  'CC BY-SA 3.0': 'https://creativecommons.org/licenses/by-sa/3.0/',
  'CC BY-SA 4.0': 'https://creativecommons.org/licenses/by-sa/4.0/',
  'CC0': 'https://creativecommons.org/publicdomain/zero/1.0/',
};
const licenseLabel = (track: MusicTrack) => track.license === 'Public domain (U.S. Air Force work)'
  ? t(track.license, '公有领域（美国空军作品）')
  : track.license === 'Public domain (U.S. government work)'
    ? t(track.license, '公有领域（美国政府作品）')
    : track.license;
---

<div class="period-music">
  <div class="music-controls">
    <button
      class="music-toggle"
      type="button"
      aria-pressed="false"
      aria-label={t(`Play ${track.title} by ${track.composer}`, `播放音乐：${track.composer}，${track.title}`)}
    >
      <span class="music-glyph" aria-hidden="true">♪</span>
      <span class="music-state">{t("Listen", "聆听")}</span>
    </button>
    {alternatives.length > 0 && <button class="music-next" type="button"
      aria-label={t('Another piece', '换一首')} title={t('Another piece', '换一首')}>
      <span aria-hidden="true">↻</span>
    </button>}
  </div>
  <div class="music-credits" aria-live="polite">
    {tracks.map((item, index) => <p class="music-credit" hidden={index !== 0}
      data-file={item.file}
      data-play-label={t(`Play ${item.title} by ${item.composer}`, `播放音乐：${item.composer}，${item.title}`)}>
      {item.composer} - <em>{item.title}</em>, {item.composed} ·{' '}
      {item.performer} · <a href={item.sourceUrl}>{item.source}</a> ·{' '}
      {DEEDS[item.license] ? <a href={DEEDS[item.license]}>{licenseLabel(item)}</a> : licenseLabel(item)}
      {item.processing && <> · {item.processing}</>}
    </p>)}
  </div>
  <audio preload="none" loop src={track.file}></audio>
</div>

<style>
  .period-music {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
  }
  .music-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .music-toggle {
    display: inline-flex;
    flex-shrink: 0;
    white-space: nowrap;
    align-items: center;
    gap: 0.45rem;
    background: none;
    border: 1px solid var(--gilt);
    border-radius: 999px;
    padding: 0.32rem 0.95rem;
    color: var(--gilt);
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .music-toggle:hover {
    background: rgba(138, 109, 59, 0.09);
  }
  .music-credits { flex: 1 1 20rem; min-width: 0; padding-top: 0.2rem; }
  .music-next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: none;
    border: none;
    padding: 0;
    color: var(--gilt);
    font: inherit;
    font-size: 1rem;
    cursor: pointer;
  }
  .music-next:hover { text-decoration: underline; }
  .music-credit {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.8;
    letter-spacing: 0.04em;
  }
  .music-credit em {
    font-family: var(--serif);
    font-size: 1rem;
  }
  .music-credit a {
    border-bottom: 1px solid var(--gilt);
  }
  @media (max-width: 640px) {
    .music-credits { flex-basis: 100%; padding-top: 0; }
  }
</style>

<script>
  function initPeriodMusic(): void {
    const root = document.querySelector<HTMLElement>('.period-music');
    if (!root || root.dataset.initialized) return;
    const button = root.querySelector<HTMLButtonElement>('.music-toggle');
    const state = root.querySelector<HTMLElement>('.music-state');
    const audio = root.querySelector<HTMLAudioElement>('audio');
    if (!button || !state || !audio) return;
    const chinese = document.documentElement.lang === 'zh-Hans';
    let playLabel = button.getAttribute('aria-label') ?? 'Play';
    root.dataset.initialized = 'true';
    audio.volume = 0.7;
    let request = 0;
    const show = (status: 'idle' | 'loading' | 'playing' | 'error'): void => {
      const active = status === 'loading' || status === 'playing';
      button.setAttribute('aria-pressed', String(active));
      button.setAttribute('aria-busy', String(status === 'loading'));
      const labels = {
        idle: chinese ? '聆听' : 'Listen',
        loading: chinese ? '加载中…' : 'Loading…',
        playing: chinese ? '暂停' : 'Pause',
        error: chinese ? '重试' : 'Retry',
      };
      state.textContent = labels[status];
      button.setAttribute('aria-label', status === 'loading'
        ? (chinese ? '音乐加载中，点击取消' : 'Loading music, click to cancel')
        : status === 'playing' ? (chinese ? '暂停音乐' : 'Pause the music')
        : status === 'error' ? (chinese ? '音乐未能播放，点击重试' : 'Music could not play, click to retry')
        : playLabel);
    };
    const credits = [...root.querySelectorAll<HTMLElement>('.music-credit')];
    let selected = 0;
    root.querySelector('.music-next')?.addEventListener('click', () => {
      const resume = !audio.paused;
      const currentRequest = ++request;
      audio.pause();
      credits[selected].hidden = true;
      selected = (selected + 1) % credits.length;
      const credit = credits[selected];
      credit.hidden = false;
      audio.src = credit.dataset.file!;
      playLabel = credit.dataset.playLabel!;
      show(resume ? 'loading' : 'idle');
      if (resume) audio.play().catch((error: DOMException) => {
        if (currentRequest !== request || error.name === 'AbortError') return;
        show('error');
      });
    });
    button.addEventListener('click', () => {
      const currentRequest = ++request;
      if (!audio.paused) {
        audio.pause();
        show('idle');
        return;
      }
      if (audio.error) audio.load();
      show('loading');
      audio.play().catch((error: DOMException) => {
        if (currentRequest !== request || error.name === 'AbortError') return;
        show('error');
      });
    });
    audio.addEventListener('playing', () => show('playing'));
    audio.addEventListener('waiting', () => {
      if (!audio.paused) show('loading');
    });
    audio.addEventListener('pause', () => {
      if (audio.paused) show(audio.error ? 'error' : 'idle');
    });
    audio.addEventListener('error', () => show('error'));
  }
  document.addEventListener('astro:page-load', initPeriodMusic);
  // Also initialize when this module arrives after the initial page-load event.
  // The per-element guard keeps both paths from attaching duplicate handlers.
  initPeriodMusic();
  // View transitions keep the old page's DOM alive during swap — stop sound explicitly.
  document.addEventListener('astro:before-swap', () => {
    document.querySelector<HTMLAudioElement>('.period-music audio')?.pause();
  });
</script>
