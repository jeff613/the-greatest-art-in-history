---
import { localizedContent, isChinese, localizedPath, text } from '../../lib/i18n';
import { getCollection as sourceCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ArtworkCard from '../../components/ArtworkCard.astro';

export async function getStaticPaths() {
  const artists = await sourceCollection('artists');
  return artists.map((artist) => ({ params: { slug: artist.id }, props: { artist } }));
}

const chinese = isChinese(Astro.url);
const href = (path: string) => localizedPath(path, chinese);
const t = (english: string, zh: string) => text(chinese, english, zh);
const { getCollection, getEntry, render, localize } = localizedContent(Astro.url);

const artist = localize(Astro.props.artist);
const period = await getEntry(artist.data.period);
const { Content } = await render(artist);
const works = (await getCollection('works', (w) => w.data.artist.id === artist.id)).sort(
  (a, b) => a.data.year.localeCompare(b.data.year)
);
const aspect = (w: (typeof works)[number]) => w.data.image.height / w.data.image.width;
const featured = works.reduce((best, w) => (aspect(w) > aspect(best) ? w : best));
---

<Base title={`${artist.data.name} - ${t("The Greatest Art in History", "艺术史上的伟大杰作")}`} dark>
  <section class="artist-hero">
    <Image
      src={artist.data.portrait}
      widths={[400, 800]}
      sizes="320px"
      alt={t(`Portrait of ${artist.data.name}`, `${artist.data.name}肖像`)}
    />
    <div>
      <p class="kicker">{period.data.name} · {artist.data.birth}–{artist.data.death}</p>
      <h1 class="display">{artist.data.name}</h1>
      <p class="artist-hook">{artist.data.hook}</p>
    </div>
  </section>

  <div class="reading-room">
    <div class="reading-center">
      <div class="bio-row">
        <article class="prose">
          <Content />
        </article>
        <a class="bio-art" href={href(`/works/${featured.id}/`)}>
          <Image
            src={featured.data.image}
            widths={[600, 1200]}
            sizes="40vw"
            alt={t(`${featured.data.title} by ${artist.data.name}`, `${artist.data.name}《${featured.data.title}》`)}
          />
          <p class="bio-art-caption">
            <em>{featured.data.title}</em> · {featured.data.year}
          </p>
        </a>
      </div>

      <section class="timeline prose">
        <h2>{t("Life in brief", "生平年表")}</h2>
        <ul role="list">
          {artist.data.timeline.map((item) => (
            <li>
              <span class="timeline-year">{chinese ? item.year.replace(/^(\d{4})s$/, '$1年代') : item.year}</span>
              <span class="timeline-event">{item.event}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="collection-band">
      <p class="kicker">{t("In the collection", "馆藏作品")}</p>
      <div class="grid">
        {works.map((work) => (
          <ArtworkCard work={work} artistName={artist.data.name} />
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .artist-hero {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    align-items: flex-end;
    padding: 8rem var(--pad) 3.5rem;
  }
  .artist-hero :global(img) {
    width: min(260px, 60vw);
    height: auto;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }
  .artist-hook {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    color: var(--muted-room);
    max-width: 30rem;
    margin: 0.4rem 0 0;
  }
  .reading-room .prose {
    margin: 0;
    padding: 0 var(--pad);
    max-width: calc(var(--measure) + 2 * var(--pad));
  }
  .bio-art { display: none; }
  @media (min-width: 1150px) {
    /* Center the reading composition (hero + bio + timeline) as one
       --wide-max block so the hung canvas sits beside the text instead of
       floating in a wide 1fr column. The collection grid stays full-bleed. */
    .artist-hero { max-width: var(--wide-max); margin-inline: auto; }
    .reading-center { max-width: var(--wide-max); margin-inline: auto; }
    .bio-row {
      display: grid;
      grid-template-columns: minmax(0, calc(var(--measure) + 2 * var(--pad))) minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
      padding-right: var(--pad);
    }
    .bio-art {
      display: block;
      justify-self: center;
      position: sticky;
      top: 6rem;
    }
    .bio-art :global(img) { max-height: min(46rem, 78vh); width: auto; }
    .bio-art-caption {
      margin: 0.9rem 0 0;
      color: var(--muted);
      font-size: 0.82rem;
      letter-spacing: 0.04em;
    }
    .bio-art-caption em { font-family: var(--serif); font-size: 1rem; }
    .reading-center .timeline { margin-inline: auto; }
    .collection-band { max-width: var(--wide-max); margin-inline: auto; }
    .collection-band .grid { justify-content: center; }
    .collection-band .grid::after { display: none; }
    .collection-band .grid :global(.card) { flex-grow: 0; }
  }
  .timeline ul { list-style: none; padding: 0; }
  .timeline li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1.25rem;
    border-top: 1px solid var(--line);
    padding: 1.25rem 0;
    margin: 0;
  }
  .timeline-year {
    color: var(--gilt);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    padding-top: 0.3rem;
  }
  .timeline-event {
    font-family: var(--serif);
    font-size: 1.3rem;
    line-height: 1.65;
  }
  @media (max-width: 480px) {
    .timeline li { grid-template-columns: 1fr; gap: 0.35rem; }
    .timeline-year { padding-top: 0; }
  }
  .collection-band { padding-top: 3.5rem; }
  .collection-band .kicker { text-align: center; }
</style>
