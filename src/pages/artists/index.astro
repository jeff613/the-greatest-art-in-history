---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const artists = await getCollection('artists');
const withPeriod = await Promise.all(
  artists.map(async (artist) => ({
    artist,
    period: await getEntry(artist.data.period),
  }))
);
withPeriod.sort(
  (a, b) => a.period.data.order - b.period.data.order || a.artist.data.birth - b.artist.data.birth
);
---

<Base title="Artists — The Greatest Art in History">
  <div class="page-head page-head-wide">
    <h1 class="display">Fifty lives<br />that changed how we see.</h1>
  </div>
  <div class="grid">
    {withPeriod.map(({ artist }, i) => (
      <a class="card" href={`/artists/${artist.id}/`} style={`--ar: ${(artist.data.portrait.width / artist.data.portrait.height).toFixed(3)}; animation-delay: ${Math.min(0.04 + i * 0.022, 0.54).toFixed(3)}s`}>
        <Image
          src={artist.data.portrait}
          widths={[400, 800]}
          sizes="(min-width: 700px) 400px, 100vw"
          alt={`Portrait of ${artist.data.name}`}
        />
        <h3>{artist.data.name}</h3>
        <p>{artist.data.birth}–{artist.data.death}</p>
        <p class="hook">{artist.data.hook}</p>
      </a>
    ))}
  </div>
</Base>

<style>
  /* The explicit two-line break governs; don't let the width cap re-wrap it. */
  .page-head-wide { max-width: none; }

  /* Cards rise in one by one, like the timeline medallions — but fifty of them,
     so the tempo is much faster and the delay is capped: the whole cascade is
     over in about a second, and nothing below the fold is ever left waiting. */
  @media (prefers-reduced-motion: no-preference) {
    .grid .card { animation: card-rise 0.45s ease-out both; }
  }
  @keyframes card-rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
</style>
