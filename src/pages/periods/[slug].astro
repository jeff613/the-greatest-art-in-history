---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ArtworkCard from '../../components/ArtworkCard.astro';
import PeriodMusic from '../../components/PeriodMusic.astro';

export async function getStaticPaths() {
  const periods = await getCollection('periods');
  return periods.map((period) => ({ params: { slug: period.id }, props: { period } }));
}

const { period } = Astro.props;
const { Content } = await render(period);
const works = await getCollection('works', (w) => w.data.period.id === period.id);
const cards = await Promise.all(
  works.map(async (work) => ({
    work,
    artistName: (await getEntry(work.data.artist)).data.name,
  }))
);
cards.sort((a, b) => a.work.data.year.localeCompare(b.work.data.year));
const aspect = (c: (typeof cards)[number]) => c.work.data.image.height / c.work.data.image.width;
const featured = cards.length
  ? cards.reduce((best, c) => (aspect(c) > aspect(best) ? c : best))
  : null;
const track = period.data.music?.[0];
---

<Base title={`${period.data.name} — The Greatest Art in History`}>
  <div class="page-head">
    <p class="kicker">{period.data.years}</p>
    <h1 class="display">{period.data.name}</h1>
    {track && <PeriodMusic track={track} />}
  </div>
  <div class="intro-row">
    <article class="prose lede intro">
      <Content />
    </article>
    {featured && (
      <a class="intro-art" href={`/works/${featured.work.id}/`}>
        <Image
          src={featured.work.data.image}
          widths={[600, 1200]}
          sizes="40vw"
          alt={`${featured.work.data.title} by ${featured.artistName}`}
        />
        <p class="intro-art-caption">
          <em>{featured.work.data.title}</em> · {featured.artistName}, {featured.work.data.year}
        </p>
      </a>
    )}
  </div>
  <div class="grid">
    {cards.map(({ work, artistName }) => (
      <ArtworkCard work={work} artistName={artistName} />
    ))}
  </div>
</Base>

<style>
  /* On wide screens the intro composition (title + essay + hung canvas) is
     capped and centered as one --wide-max block, so it never sprawls
     edge-to-edge with a void in the middle. */
  .intro-row { margin-bottom: 1.5rem; }
  .intro {
    margin: 0;
    padding: 0 var(--pad);
    max-width: calc(var(--measure) + 2 * var(--pad));
  }
  .intro-art { display: none; }
  @media (min-width: 1150px) {
    .page-head { max-width: var(--wide-max); margin-inline: auto; }
    .intro-row {
      display: grid;
      grid-template-columns: minmax(0, calc(var(--measure) + 2 * var(--pad))) minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
      padding-right: var(--pad);
      max-width: var(--wide-max);
      margin-inline: auto;
    }
    .intro-art { display: block; justify-self: center; }
    .intro-art img { max-height: min(46rem, 78vh); width: auto; }
    .intro-art-caption {
      margin: 0.9rem 0 0;
      color: var(--muted);
      font-size: 0.82rem;
      letter-spacing: 0.04em;
    }
    .intro-art-caption em { font-family: var(--serif); font-size: 1rem; }
    /* The works grid sits centered under the intro, capped to the same wide
       max, with cards centered instead of justified edge-to-edge. */
    .grid {
      max-width: var(--wide-max);
      margin-inline: auto;
      justify-content: center;
    }
    .grid::after { display: none; }
    .grid :global(.card) { flex-grow: 0; }
  }
</style>
