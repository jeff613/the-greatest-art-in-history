---
import { getCollection, getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import focal from '../data/focal-points.json';

const works = await getCollection('works');
const entries = await Promise.all(
  works
    .sort((a, b) => a.id.localeCompare(b.id))
    .map(async (work) => {
      const artist = await getEntry(work.data.artist);
      const period = await getEntry(work.data.period);
      const hero = await getImage({ src: work.data.image, width: 2400, format: 'webp' });
      const f = (focal as Record<string, { x: number; y: number }>)[work.id];
      return {
        slug: work.id,
        title: work.data.title,
        artist: artist.data.name,
        year: work.data.year,
        period: period.data.name,
        src: hero.src,
        fx: f?.x ?? 50,
        fy: f?.y ?? 50,
      };
    })
);
---

<Base dark bare>
  <div class="walk-scroller">
  <section class="daily-hero">
    <a id="daily-link" class="daily-bg" href="/artists/" aria-label="Read the story of the featured artwork">
      <img id="daily-img" alt="" />
      <span class="scrim"></span>
    </a>
    <div class="wall-label">
      <p class="kicker anim-rise" id="daily-kicker"></p>
      <h1 class="display italic anim-rise" id="daily-title"></h1>
      <p class="byline anim-rise-2" id="daily-byline"></p>
      <a class="read-link anim-rise-2" id="daily-read" href="/artists/">Read the story →</a>
    </div>
    <div class="scroll-cue" aria-hidden="true"><span class="cue-track"></span></div>
    <noscript>
      <div class="noscript-home">
        <p class="wordmark">The Greatest</p>
        <p><a href="/artists/">Artists</a> · <a href="/periods/">Periods</a></p>
      </div>
    </noscript>
  </section>

  <div id="gallery-walk"></div>

  <template id="room-template">
    <section class="room">
      <a class="daily-bg room-link" href="/">
        <img class="room-img" alt="" loading="lazy" decoding="async" />
        <span class="scrim"></span>
      </a>
      <div class="wall-label">
        <p class="kicker room-period"></p>
        <h2 class="display italic room-title"></h2>
        <p class="byline room-byline"></p>
        <a class="read-link room-read" href="/">Read the story →</a>
      </div>
    </section>
  </template>

  <section class="walk-end" id="walk-end" hidden>
    <p class="kicker">You've walked the whole gallery</p>
    <p class="walk-end-links"><a href="/artists/">Artists</a> · <a href="/periods/">Periods</a></p>
  </section>

  <script type="application/json" id="works-data" set:html={JSON.stringify(entries).replace(/</g, '\\u003c')} />
  </div>
</Base>

<style>
  /* The walk scrolls inside a fixed-height container, not the document:
     iOS Safari's collapsing toolbar can't change the scrollport mid-scroll,
     so snap positions never drift and no neighboring room peeks through. */
  :global(html), :global(body) { height: var(--screen); overflow: hidden; }
  .walk-scroller {
    height: var(--screen);
    overflow-y: auto;
    scroll-snap-type: y mandatory;
  }
  :global(.site-header) { position: fixed; }
  .daily-hero { scroll-snap-align: start; }
  /* No standing scroll cue: the walk hints at itself by drifting down a
     sliver and settling back (initScrollHint below), which shows the next
     canvas rather than pointing at it.
     The one exception is prefers-reduced-motion, where that drift never runs
     — those viewers get a quiet static rail instead of no signal at all.
     Bottom-RIGHT because the wall label is bottom-left at the same height. */
  .scroll-cue { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      display: block;
      position: absolute;
      top: calc(var(--screen-small) - 3.8rem - env(safe-area-inset-bottom, 0px));
      right: var(--pad);
      z-index: 2;
      pointer-events: none;
    }
    .cue-track {
      display: block;
      width: 1px;
      height: 2.4rem;
      background: linear-gradient(to bottom, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.5));
    }
  }
  :global(#gallery-walk .room) {
    position: relative;
    height: var(--screen);
    scroll-snap-align: start;
  }
  :global(#gallery-walk .room-img) { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    :global(#gallery-walk .room-img) { opacity: 0; transition: opacity 1.2s ease-out; }
    :global(#gallery-walk .room-img.is-loaded) { opacity: 1; }
  }
  .walk-end {
    min-height: 42svh;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 0.4rem;
    scroll-snap-align: end;
  }
  .walk-end-links { margin: 0; }
  .walk-end-links a { border-bottom: 1px solid var(--gilt); }
  /* TV gallery mode: while auto-scrolling, drop the cursor so the display
     reads as pure art. (No cue to hide: the drift hint is one-shot and long
     finished by the time the 60s idle timer fires, and the reduced-motion
     rail can't coexist with TV mode, which never starts under that setting.) */
  .walk-scroller.autoscrolling { cursor: none; }
</style>

<script>
  type Entry = {
    slug: string;
    title: string;
    artist: string;
    year: string;
    period: string;
    src: string;
    fx: number;
    fy: number;
  };

  function initHome(): void {
    const dataEl = document.getElementById('works-data');
    if (!dataEl) return; // not the home page
    const data: Entry[] = JSON.parse(dataEl.textContent!);

    // First slide + walk: one fresh shuffle of every work each visit. The
    // first work simply leads the walk — no "artwork of the day" framing.
    const shuffled = [...data];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    const hero = shuffled[0];

    const heroImg = document.getElementById('daily-img') as HTMLImageElement;
    heroImg.addEventListener('load', () => heroImg.classList.add('is-loaded'), { once: true });
    heroImg.src = hero.src;
    heroImg.alt = `${hero.title} by ${hero.artist}`;
    // Crop pivots around the painting's focal point (face/subject) so the
    // full-bleed treatment never cuts off what matters.
    heroImg.style.objectPosition = `${hero.fx}% ${hero.fy}%`;
    if (heroImg.complete) heroImg.classList.add('is-loaded');

    document.getElementById('daily-kicker')!.textContent = hero.period;
    document.getElementById('daily-title')!.textContent = hero.title;
    document.getElementById('daily-byline')!.textContent = `${hero.artist}, ${hero.year}`;
    const heroUrl = `/works/${hero.slug}/`;
    (document.getElementById('daily-link') as HTMLAnchorElement).href = heroUrl;
    (document.getElementById('daily-read') as HTMLAnchorElement).href = heroUrl;
    document.getElementById('daily-link')!.setAttribute('aria-label', `Read the story of ${hero.title}`);
    document.getElementById('daily-read')!.setAttribute('aria-label', `Read the story of ${hero.title}`);

    // Bound before the "already built" bail-out below so a view-transition
    // re-entry still arms the hint.
    const hintScroller = document.querySelector<HTMLElement>('.walk-scroller');
    if (hintScroller) initScrollHint(hintScroller);

    // Gallery walk: the works after the first, same shuffle.
    const walk = document.getElementById('gallery-walk')!;
    if (walk.childElementCount > 0) return; // already built (defensive)
    const template = document.getElementById('room-template') as HTMLTemplateElement;

    const WALK_SIZE = 24;
    const rooms = shuffled.slice(1, 1 + WALK_SIZE);

    for (const entry of rooms) {
      const node = template.content.cloneNode(true) as DocumentFragment;
      const img = node.querySelector('.room-img') as HTMLImageElement;
      img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
      img.src = entry.src;
      img.alt = `${entry.title} by ${entry.artist}`;
      img.style.objectPosition = `${entry.fx}% ${entry.fy}%`;
      node.querySelector('.room-period')!.textContent = entry.period;
      node.querySelector('.room-title')!.textContent = entry.title;
      node.querySelector('.room-byline')!.textContent = `${entry.artist}, ${entry.year}`;
      const url = `/works/${entry.slug}/`;
      (node.querySelector('.room-link') as HTMLAnchorElement).href = url;
      (node.querySelector('.room-read') as HTMLAnchorElement).href = url;
      (node.querySelector('.room-link') as HTMLAnchorElement).setAttribute('aria-label', `Read the story of ${entry.title}`);
      (node.querySelector('.room-read') as HTMLAnchorElement).setAttribute('aria-label', `Read the story of ${entry.title}`);
      walk.appendChild(node);
    }

    document.getElementById('walk-end')!.hidden = false;
  }

  // --- first-visit scroll hint ----------------------------------------------
  // Instead of an icon, the walk demonstrates itself: shortly after the hero
  // settles it drifts down far enough to show the top edge of the next canvas,
  // then eases back. Runs once, and only if the viewer hasn't already moved.
  // The hero's last entrance animation (.anim-rise-2) ends at 1450ms
  // (0.55s delay + 0.9s rise), so anything near that treads on it. Wait out
  // the entrance and then hold still a beat, so the drift reads as a separate
  // gesture rather than the tail of the animation.
  const HINT_DELAY = 2600;
  const HINT_DOWN = 560;
  const HINT_HOLD = 260;
  const HINT_UP = 700;

  // "Once" means once per viewer, not once per load — the walk only has to
  // introduce itself the first time. Storage throws in private browsing, and
  // the honest fallback there is to hint again rather than never.
  const HINT_SEEN_KEY = 'walk-hint-seen';
  const hintSeen = (): boolean => {
    try { return localStorage.getItem(HINT_SEEN_KEY) === '1'; } catch { return false; }
  };
  const markHintSeen = (): void => {
    try { localStorage.setItem(HINT_SEEN_KEY, '1'); } catch { /* hint again next visit */ }
  };

  function initScrollHint(scroller: HTMLElement): void {
    if (scroller.dataset.hintBound) return;
    scroller.dataset.hintBound = '1';
    if (hintSeen()) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return; // static rail instead

    let cancelled = false;
    // Any real input means they've found it themselves — abandon the hint and
    // leave the scroll position wherever they put it. That counts as seen:
    // someone who scrolls unprompted does not need showing again.
    const cancel = (): void => { cancelled = true; markHintSeen(); };
    for (const evt of ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const) {
      window.addEventListener(evt, cancel, { passive: true, once: true });
    }

    window.setTimeout(() => {
      if (cancelled || scroller.scrollTop > 0) return;
      // Recorded as the drift commits rather than when it finishes, so a
      // viewer who interrupts it halfway still counts as having seen it.
      markHintSeen();

      // A sliver of the next room: enough to read as "there is another canvas
      // below", not so much that it looks like the page jumped.
      const dist = Math.min(96, Math.max(48, Math.round(scroller.clientHeight * 0.08)));

      // `scroll-snap-type: y mandatory` yanks any partial offset straight back
      // to a snap point, which would eat the drift entirely. Suspend snapping
      // for the hint and restore it once we're back at rest.
      const snap = scroller.style.scrollSnapType;
      scroller.style.scrollSnapType = 'none';
      const restore = (): void => { scroller.style.scrollSnapType = snap; };

      const easeOut = (t: number): number => 1 - Math.pow(1 - t, 3);
      const easeInOut = (t: number): number =>
        t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

      const tween = (
        from: number, to: number, dur: number,
        ease: (t: number) => number, then: () => void,
      ): void => {
        const t0 = performance.now();
        const step = (now: number): void => {
          if (cancelled) { restore(); return; }
          const p = Math.min(1, (now - t0) / dur);
          scroller.scrollTop = from + (to - from) * ease(p);
          if (p < 1) requestAnimationFrame(step);
          else then();
        };
        requestAnimationFrame(step);
      };

      tween(0, dist, HINT_DOWN, easeOut, () => {
        window.setTimeout(() => {
          if (cancelled) { restore(); return; }
          tween(dist, 0, HINT_UP, easeInOut, () => { scroller.scrollTop = 0; restore(); });
        }, HINT_HOLD);
      });
    }, HINT_DELAY);
  }

  document.addEventListener('astro:page-load', initHome);

  // --- TV gallery mode: idle auto-scroll -------------------------------------
  // On the home walk, after the viewer stops touching it, drift through the
  // rooms on our own (one room every DWELL_MS) for an unattended TV display.
  // Any real input stops it and re-arms the idle countdown.
  const IDLE_MS = 60_000;        // no input for this long → auto-scroll starts
  const DWELL_MS = 15 * 60_000;  // hold each room this long before advancing

  function initTvMode(): void {
    const scroller = document.querySelector<HTMLElement>('.walk-scroller');
    if (!scroller || scroller.dataset.tvBound) return;                  // home page only, once
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return; // motion opt-out: never auto-scroll
    scroller.dataset.tvBound = '1';

    const ctrl = new AbortController();
    const { signal } = ctrl;
    let idleTimer = 0;
    let stepTimer = 0;
    let running = false;
    let lastX = -1;
    let lastY = -1;
    let wakeLock: WakeLockSentinel | null = null;

    // Keep the TV/display from sleeping mid-gallery. Silently degrade where
    // the API is absent (older/embedded browsers) or the request is denied.
    const acquireWake = async (): Promise<void> => {
      try { wakeLock = (await navigator.wakeLock?.request('screen')) ?? null; }
      catch { /* unsupported or denied — carry on without it */ }
    };
    const releaseWake = (): void => {
      try { void wakeLock?.release(); } catch { /* already gone */ }
      wakeLock = null;
    };

    // Loop as soon as the LAST artwork room is on screen, not at the very
    // bottom — otherwise the "you've walked the whole gallery" end card would
    // sit frozen on the TV for a full dwell before the walk restarts.
    const atLastRoom = (): boolean => {
      const last = scroller.querySelector<HTMLElement>('#gallery-walk .room:last-child');
      if (!last) return true;
      return last.getBoundingClientRect().top - scroller.getBoundingClientRect().top <= 2;
    };

    const advance = (): void => {
      // Reset instantly, not smoothly: a long smooth scroll back across two
      // dozen rooms fights `scroll-snap-type: mandatory` and stalls partway,
      // so the walk never reaches the top. One cut is fine at this pace.
      if (atLastRoom()) scroller.scrollTo({ top: 0 });
      else scroller.scrollBy({ top: scroller.clientHeight, behavior: 'smooth' });
    };

    const start = (): void => {
      if (running) return;
      running = true;
      scroller.classList.add('autoscrolling');
      void acquireWake();
      stepTimer = window.setInterval(advance, DWELL_MS);
    };

    const stop = (): void => {
      if (!running) return;
      running = false;
      scroller.classList.remove('autoscrolling');
      window.clearInterval(stepTimer);
      releaseWake();
    };

    const armIdle = (): void => {
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(start, IDLE_MS);
    };

    const onInput = (): void => {
      stop();
      armIdle();
    };

    // A stationary cursor with content scrolling beneath it emits mousemove
    // events at UNCHANGED coordinates. If we treated those as input, our own
    // programmatic scroll would cancel itself. Only a real pointer move counts.
    const onMouseMove = (e: MouseEvent): void => {
      if (e.clientX === lastX && e.clientY === lastY) return;
      lastX = e.clientX;
      lastY = e.clientY;
      onInput();
    };

    scroller.addEventListener('wheel', onInput, { passive: true, signal });
    scroller.addEventListener('touchstart', onInput, { passive: true, signal });
    scroller.addEventListener('pointerdown', onInput, { signal });
    window.addEventListener('keydown', onInput, { signal });
    window.addEventListener('mousemove', onMouseMove, { signal });
    // The lock is auto-released when the tab is hidden; re-acquire on return.
    document.addEventListener('visibilitychange', () => {
      if (running && document.visibilityState === 'visible') void acquireWake();
    }, { signal });

    // ClientRouter keeps the old DOM alive during a view-transition swap;
    // tear down timers and listeners explicitly so nothing leaks.
    document.addEventListener('astro:before-swap', () => {
      stop();
      window.clearTimeout(idleTimer);
      ctrl.abort();
      delete scroller.dataset.tvBound;
    }, { once: true });

    armIdle();
  }
  document.addEventListener('astro:page-load', initTvMode);
</script>
